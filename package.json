{
  "name": "@cadolabs/traffic-ui-kit",
  "version": "0.16.0",
  "type": "module",
  "main": "dist/traffic-ui-kit.umd.js",
  "module": "dist/traffic-ui-kit.es.js",
  "types": "dist/traffic-ui-kit.es.d.ts",
  "exports": {
    ".": {
      "import": "./dist/traffic-ui-kit.es.js",
      "require": "./dist/traffic-ui-kit.umd.js"
    }
  },
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "registry": "https://gitlab.task4work.info/api/v4/projects/303/packages/npm/",
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "generate-db": "node dev-server/generate-table-db.js && node dev-server/generate-chat-db.js",
    "start:json-server": "node dev-server/server.js",
    "test:unit": "vitest --coverage",
    "coverage": "vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run-e2e": "cypress run --e2e",
    "test:e2e": "start-server-and-test dev http://localhost:5173 cy:run-e2e",
    "cy:run:allure": "cypress run --headless --browser=chrome --env allure=true",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "peerDependencies": {
    "vue": "^3.5.12"
  },
  "dependencies": {
    "@kyvg/vue3-notification": "^3.4.1",
    "@vuepic/vue-datepicker": "^10.0.0",
    "axios": "1.8.2",
    "floating-vue": "^5.2.2",
    "lodash": "^4.17.21",
    "qs": "^6.13.1",
    "tiny-emitter": "^2.1.0",
    "vue-draggable-next": "^2.2.1",
    "vue-multiselect": "^3.1.0",
    "vue-sidebar-menu": "^5.4.2",
    "vue3-clipboard": "^1.0.0",
    "vue3-cookies": "^1.0.6"
  },
  "devDependencies": {
    "@shelex/cypress-allure-plugin": "^2.41.2",
    "@tsconfig/node22": "^22.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/lodash": "^4.17.14",
    "@types/node": "^22.9.0",
    "@types/prismjs": "^1.26.5",
    "@types/qs": "^6.9.17",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "@vitest/coverage-v8": "^3.0.7",
    "@vitest/eslint-plugin": "1.1.7",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "allure-commandline": "^2.43.0",
    "cypress": "^15.10.0",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "jsdom": "^25.0.1",
    "json-2-csv": "^5.5.9",
    "json-server": "0.17.4",
    "npm-run-all2": "^7.0.1",
    "prettier": "^3.3.3",
    "prismjs": "1.30.0",
    "typescript": "~5.6.3",
    "vite": "6.3.4",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-vue-devtools": "^7.5.4",
    "vitest": "^3.0.7",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.1.10"
  }
}